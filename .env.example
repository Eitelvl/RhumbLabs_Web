# Public template only. Copy to .env.local for local overrides.
# VITE_* values are embedded in browser JavaScript: never put secrets here.

# Pogo Event uses the public configuration of the Firebase Web App registered
# in the same climbscore-faf5d project as Pogo. These values are identifiers,
# not administrative secrets. Authorization is enforced by a server-side event
# key, Firebase custom-token Auth, App Check, and Security Rules. Configure the
# key as the POGO_EVENT_ACCESS_KEY secret in Cloud Functions, never as VITE_*.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="climbscore-faf5d.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="climbscore-faf5d"
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FUNCTIONS_REGION="us-central1"
VITE_FIREBASE_APPCHECK_SITE_KEY=""

# Local development only. Use true to let Firebase print a debug token, then
# register that token in Firebase Console > App Check.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=""

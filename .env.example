# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Pogo Event uses the public configuration of the Firebase Web App registered
# in the same climbscore-faf5d project as Pogo. These values are identifiers,
# not administrative secrets. Authorization is enforced by Auth, App Check,
# Security Rules, and the pogoEventAdmin custom claim.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="climbscore-faf5d.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="climbscore-faf5d"
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FUNCTIONS_REGION="us-central1"
VITE_FIREBASE_APPCHECK_SITE_KEY=""

# Local development only. Use true to let Firebase print a debug token, then
# register that token in Firebase Console > App Check.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=""
